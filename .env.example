# Copy to .env. Never commit .env.

# PostgreSQL (local or Neon pooled URL). Neon also provides DATABASE_URL_UNPOOLED for migrations.
DATABASE_URL="postgresql://user@localhost:5432/jd_main"
# DATABASE_URL_UNPOOLED=""

# Claude API — without it matching runs keyword-only and AI helpers show a fallback.
# ANTHROPIC_API_KEY=""

# Signs staff session cookies. Generate: openssl rand -base64 48
# SESSION_SECRET=""
# AES-256-GCM key for contact details. Generate: openssl rand -base64 32
# CONTACT_ENC_KEY=""

# E-mail: Resend (verified domain) or SMTP. Without them deliveries are logged as "skipped".
# RESEND_API_KEY=""
# MAIL_FROM="Już Działa <powiadomienia@twoja-domena.pl>"
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# ROPS_INBOX_EMAIL=""

# 1 = public demo: one-click staff login, contacts masked, e-mail to authors needs confirmation.
DEMO_MODE="1"
