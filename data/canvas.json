            },
            {
              "key": "blockers",
              "label": "Utrudniają zmianę",
              "prompt": "Wypiszcie osoby, grupy lub instytucje, które mogą nie chcieć zmiany, bać się jej, tracić na niej albo utrudniać wdrożenie.",
