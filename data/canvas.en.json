    {
      "key": "sheet1",
      "title": "#01 SOCIAL INNOVATION CANVAS",
      "page": 1,
      "sections": [
        {
          "key": "problem",
          "label": "PROBLEM",
          "prompt": null,
          "subfields": [
            "Intensity",
            "Frequency",
            "Scale of the problem"
          ],
          "fields": [
            {
              "key": "intensity",
              "label": "Intensity",
              "prompt": "Mark how bad things are without your solution:",
              "kind": "single",
              "options": [
                {
                  "label": "A very serious problem",
                  "description": "It causes stress, exclusion or real harm."
                },
                {
                  "label": "A major obstacle",
                  "description": "The problem regularly blocks important activities."
                },
                {
                  "label": "Makes things difficult",
                  "description": "People have to look for alternatives and lose time or energy."
                },
                {
                  "label": "A minor nuisance",
                  "description": "People can live with it; the problem is more irritating than blocking."
                }
              ],
              "questions": []
            },
            {
              "key": "frequency",
              "label": "Frequency",
              "prompt": "Colour in to show how often the problem your solution addresses occurs:",
              "kind": "single",
              "options": [
                {
                  "label": "Very often",
                  "description": "Every day or almost every day."
                },
                {
                  "label": "Often",
                  "description": "Every week or regularly."
                },
                {
                  "label": "Sometimes",
                  "description": "A few times a year or a month."
                },
                {
                  "label": "Rarely",
                  "description": "Once in a while – once a year or less often."
                }
              ],
              "questions": []
            },
            {
              "key": "scale",
              "label": "Scale of the problem",
              "prompt": "Mark how many people are affected by the problem:",
              "kind": "single",
              "options": [
                {
                  "label": "Individuals",
                  "description": "It affects a few people or a small group."
                },
                {
                  "label": "A narrow group",
                  "description": "It affects a specific community, e.g. pupils at one school, people from one area, or staff of a particular institution."
                },
                {
                  "label": "A large group",
                  "description": "It affects many people in a city, region, sector or larger community."
                },
                {
                  "label": "A very wide group",
                  "description": "It affects a large part of society or many similar groups in different places."
                }
              ],
              "questions": []
            }
          ]
        },
        {
          "key": "changeActors",
          "label": "ACTORS OF CHANGE",
          "prompt": null,
          "subfields": [
            "Support change",
            "Hinder change"
          ],
          "fields": [
            {
              "key": "supporters",
              "label": "Support change",
              "prompt": "List the people, groups or institutions that see the need for change, support your idea or can help put it into practice.",
              "kind": "text",
              "options": [],
              "questions": [
                "Who needs this change most?",
                "Who could benefit from the solution?",
                "Who is already saying the problem needs to be solved?",
                "Who could back you, recommend you or open doors for you?",
                "Who has the energy, influence or resources to help?"
              ]
            },
            {
              "key": "blockers",
              "label": "Hinder change",
              "prompt": "List the people, groups or institutions that may not want the change, may fear it, may lose out because of it or may make implementation difficult.",
              "kind": "text",
              "options": [],
              "questions": [
                "Who may not understand the need for change?",
                "Who may fear extra work, costs or risk?",
                "Who may lose influence, control or their current role?",
                "Who might say “this won’t work”?",
                "Who could block a decision, funding or access to users?"
              ]
            }
          ]
        },
        {
          "key": "solution",
          "label": "SOLUTION",
          "prompt": null,
          "subfields": [
            "Accessibility and value of the solution",
            "Readiness for implementation",
            "Simplicity and clarity"
          ],
          "fields": [
            {
              "key": "valueForCost",
              "label": "Accessibility and value of the solution",
              "prompt": null,
              "kind": "single",
              "options": [
                {
                  "label": "The cost is greater than the benefit",
                  "description": "The solution uses a lot of money, time or effort, and the effect is barely visible."
                },
                {
                  "label": "The benefit and cost are similar",
                  "description": "The solution may help, but it is not clear whether it is worth using."
                },
                {
                  "label": "The benefit is greater than the cost",
                  "description": "The solution offers noticeable value at a reasonable price."
                },
                {
                  "label": "Very high value at low cost",
                  "description": "The solution helps effectively, and the barrier to entry is low (low costs, time savings, ease of use)."
                }
              ],
              "questions": []
            },
            {
              "key": "readiness",
              "label": "Readiness for implementation",
              "prompt": null,
              "kind": "single",
              "options": [
                {
                  "label": "Idea",
                  "description": "We have a concept, but the solution has not yet been checked with users."
                },
                {
                  "label": "Prototype",
                  "description": "We have a first version of the solution, but it still needs testing and improvement."
                },
                {
                  "label": "Tested solution",
                  "description": "The solution has been checked with real users and we know what needs improving"
                },
                {
                  "label": "Ready for implementation",
                  "description": "The solution can be launched in a real place, with real users and known resources."
                }
              ],
              "questions": []
            },
            {
              "key": "clarity",
              "label": "Simplicity and clarity",
              "prompt": "Does a person seeing your solution for the first time quickly understand who it is for, how it works and what it offers? Mark the option that is most true:",
              "kind": "single",
              "options": [
                {
                  "label": "The solution is unclear",
                  "description": "It takes a long time to explain what it is about. People often ask basic questions."
                },
                {
                  "label": "The solution is partly clear",
                  "description": "People understand the general idea, but do not yet know exactly how to use it."
                },
                {
                  "label": "The solution is clear",
                  "description": "Most people quickly understand what problem we are solving, how the solution works and what they need to do to use it."
                },
                {
                  "label": "People can explain it themselves",
                  "description": "A person from the target group can explain the solution in their own words after briefly coming across it / using it."
                }
              ],
              "questions": []
            }
          ]
        },
        {
          "key": "costStructure",
          "label": "COST STRUCTURE",
          "prompt": null,
          "subfields": [
            "Fixed costs",
            "Variable costs"
          ],
          "fields": [
            {
              "key": "fixedCosts",
              "label": "Fixed costs",
              "prompt": "You pay these regardless of the number of users. They have to be paid even when few people use the solution or nobody uses it yet. → Mark / add the costs you pay or should pay for the solution to work:",
