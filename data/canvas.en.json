            {
              "key": "variableCosts",
              "label": "Variable costs",
              "prompt": "These grow when more people use the solution or when you carry out more activities. What does it cost each time you help another person or group, or organise another activity? → Mark / add the variable costs that may arise:",
              "kind": "multi",
              "options": [
                {
                  "label": "materials for participants",
                  "description": null
                },
                {
                  "label": "a specialist’s time per person",
